AGNES_API_KEY=your_api_key_here
API_BASE_URL=https://apihub.agnes-ai.com
PORT=3001

# Optional shared token for key-management + proxy routes (recommended when
# the proxy is reachable by anyone other than you).
# PROXY_TOKEN=

# Comma-separated CORS allowlist of client origins.
# CLIENT_ORIGIN=http://localhost:5173

# Round 4: set ONLY when running behind a reverse proxy so the rate limiter
# keys on the real client IP. Unset = no trust (safe default, X-Forwarded-For
# is ignored). Examples:
#   TRUST_PROXY=1                  # one proxy hop
#   TRUST_PROXY=10.0.0.1,10.0.0.2  # CIDR/IP list
#   TRUST_PROXY=loopback           # express subnet shorthand
# TRUST_PROXY=1

# JSON body limit (default 2mb).
# BODY_LIMIT=2mb
